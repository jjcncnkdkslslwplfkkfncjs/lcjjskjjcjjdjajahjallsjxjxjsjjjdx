local function GitAud(soundgit, filename)
	local FileName = filename .. ".mp3"

	if not isfile(FileName) then
		writefile(
			FileName,
			game:HttpGet(soundgit)
		)
	end

	return (getcustomasset or getsynasset)(FileName)
end

local function CustomGitSound(soundlink, vol, filename)
	local sound = Instance.new("Sound")
	sound.SoundId = GitAud(soundlink, filename)
	sound.Parent = workspace
	sound.Volume = vol
	sound.Name = "GoofierVL1"
	
	sound:Play()
end

