local function Moving(target, dur)
	if ActiveTween then
		ActiveTween:Cancel()
		ActiveTween = nil
	end

	if not Move then
		return
	end

	local tween_info = TweenInfo.new(
		dur,
		Enum.EasingStyle.Quad,
		Enum.EasingDirection.Out
	)

	ActiveTween = TweenService:Create(
		entity,
		tween_info,
		{CFrame = target}
	)

	ActiveTween:Play()
	ActiveTween.Completed:Wait()

	ActiveTween = nil
end

